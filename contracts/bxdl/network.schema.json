{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BXDL QBFT public network v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "BXDL_QBFT_NETWORK"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "validatorId",
        "host",
        "port",
        "transactionPermission",
        "credentialFingerprints"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/pin"
        },
        "validatorId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "transactionPermission": {
          "enum": [
            "NONE",
            "RELAY",
            "INGRESS"
          ]
        },
        "credentialFingerprints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pin"
          }
        },
        "revokedCredentialFingerprints": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pin"
          }
        }
      }
    }
  },
  "$id": "urn:bxdl:network:development:1",
  "$comment": "Public input only. CLI additionally checks duplicate keys, canonical endpoint/pin ownership, complete approved-chain validator membership, product local identity, file identity/permissions and 256 KiB input/output limits. No key issuance, X.509 validation or network readiness is implied."
}
