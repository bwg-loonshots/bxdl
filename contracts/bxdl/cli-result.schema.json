{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BXDL CLI result envelope v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "outcome": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "INCOMPLETE",
        "UNSUPPORTED",
        "UNKNOWN"
      ]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "message": {
      "type": "string"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {}
  },
  "required": [
    "schemaVersion",
    "command",
    "outcome",
    "reasonCode",
    "message",
    "observedAt"
  ]
}
