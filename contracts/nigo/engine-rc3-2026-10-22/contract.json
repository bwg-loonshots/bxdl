{
  "engine": "NIGO",
  "status": "PROPOSED",
  "commands": ["engine-info", "preflight", "init", "resume-init", "run", "storage-integrity"],
  "configuration": "explicit-node-and-public-chain-json",
  "backends": ["h2", "rocksdb"],
  "httpAccess": "LOOPBACK_ONLY",
  "qbftTransport": "MTLS",
  "readiness": {"syncObservation": "MEMORY_ONLY_FOLLOWER_PHASE", "syncStatuses": ["UNKNOWN", "NEGOTIATING", "DOWNLOADING", "RETRYING", "FOLLOWING", "FAILED"], "recoveringFollower": "NOT_READY", "failedFollower": "FAILED", "followingGuaranteesCaughtUp": false, "disabledSync": "UNKNOWN", "activeValidatorUsesFollowerPhase": false},
  "preflight": {"opensDatabase": false, "startsNetwork": false, "signs": false, "generatesKeys": false, "successStatus": "INCOMPLETE", "exitCode": 3},
  "storageIntegrity": {
    "command": "storage-integrity",
    "configuration": "EXPLICIT_EXISTING_DATABASE_OPTIONS",
    "backends": ["rdb", "rocksdb"],
    "pathPolicy": "ABSOLUTE_NORMALIZED_NO_SYMLINK_COMPONENT",
    "defaultMode": "inspect",
    "defaultTarget": "commitment",
    "targets": ["commitment", "balances"],
    "repairConfirmation": "--confirm-repair=true",
    "databasePasswordEnvironment": "NIGO_STORAGE_PASSWORD",
    "opensDatabase": true,
    "inspectMayWritePhysicalFiles": true,
    "startsApplication": false,
    "startsNetwork": false,
    "signs": false,
    "generatesKeys": false,
    "createsDatabaseOrSchema": false,
    "automaticRepair": false,
    "engineInstanceValidation": false,
    "externalChainValidation": false,
    "identityScope": "DATABASE_INTERNAL_ONLY",
    "exclusiveOwnership": "PHYSICAL_BACKEND_OPEN_UNTIL_CLOSE",
    "stdout": "SINGLE_JSON_AFTER_BACKEND_CLOSE",
    "stdoutWriteFailure": "EXIT_74_NO_REEMISSION",
    "processReport": false,
    "repairPostCommitAudit": "HEALTHY_REQUIRED_WHEN_AUDIT_REPAIRED",
    "missingOrPartialResult": "UNKNOWN",
    "exitCodes": {"0": "HEALTHY_OR_VERIFIED_REPAIR", "2": "CORRUPT", "3": "INCOMPLETE", "4": "BLOCKED", "64": "INVALID_ARGUMENTS", "74": "UNAVAILABLE"}
  },
  "processReport": {"format": "JSONL", "requiredIdentity": ["attemptId", "command", "sequence", "pid", "observedAt"], "missingTerminalResult": "UNKNOWN", "qbftShutdownConfirmation": "OWNED_WORKER_DRAIN_AND_STORAGE_CLOSE", "qbftShutdownResult": "STOPPED_ONLY_WHEN_CONFIRMED", "unconfirmedShutdownResult": "UNKNOWN"},
  "exitCodes": {"0": "ONE_SHOT_SUCCESS", "2": "STORAGE_CORRUPT", "3": "INCOMPLETE", "4": "STORAGE_BLOCKED", "64": "INVALID_CONFIGURATION_OR_ARGUMENTS", "74": "PRECONDITION_IO_STARTUP_OR_STORAGE_FAILURE"},
  "distribution": {"channel": "development", "officialRelease": false, "consumerAcceptance": "NOT_RUN"}
}
